# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# 상담자 로그인(/send, /admin) 비밀번호 - 원하는 값으로 설정
ADMIN_PASSWORD=원하는비밀번호

# 로그인 세션 쿠키에 쓰이는 임의의 긴 문자열 (아무 값이나 무작위로, 다른 사람이 추측 못하게)
SESSION_TOKEN=아무렇게나-긴-무작위-문자열

# 자동 이메일 발송 (EmailJS - emailjs.com 무료 계정에서 확인)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=xxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=xxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxx
